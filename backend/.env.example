# Copy to backend/.env and fill in the values.
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8501

# PostgreSQL (used by both the postgres container and Django)
POSTGRES_DB=procurelens
POSTGRES_USER=procurelens
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://procurelens:<POSTGRES_PASSWORD>@postgres:5432/procurelens

REDIS_URL=redis://redis:6379/0

# Initial superuser (created by entrypoint.sh; skipped if password is empty)
DJANGO_SUPERUSER_EMAIL=admin@procurelens.com
DJANGO_SUPERUSER_PASSWORD=

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@procurelens.com
